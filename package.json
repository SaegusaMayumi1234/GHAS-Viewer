{
  "name": "ghas-viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc -b",
    "build": "vue-tsc -b && vite build",
    "build:single": "vue-tsc -b && cross-env BUILD_SINGLEFILE=true vite build",
    "build:all": "pnpm build && pnpm build:single",
    "preview": "vite preview"
  },
  "dependencies": {
    "@primeuix/themes": "^1.2.3",
    "@vueuse/core": "^14.3.0",
    "dompurify": "^3.4.9",
    "fuse.js": "^7.4.2",
    "@lucide/vue": "^1.0.0",
    "markdown-it": "^14.2.0",
    "pinia": "^3.0.4",
    "primevue": "^4.5.5",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "cross-env": "^10.1.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vite-plugin-singlefile": "^2.3.3",
    "vue-tsc": "^3.2.8"
  }
}
