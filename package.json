{
  "name": "ghas-viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc -b",
    "build": "vue-tsc -b && vite build",
    "build:single": "vue-tsc -b && cross-env BUILD_SINGLEFILE=true vite build",
    "build:all": "pnpm build && pnpm build:single",
    "preview": "vite preview"
  },
  "dependencies": {
    "@primeuix/themes": "^2.0.3",
    "@vueuse/core": "^14.4.0",
    "dompurify": "^3.4.12",
    "fuse.js": "^7.5.0",
    "@lucide/vue": "^1.28.0",
    "markdown-it": "^15.0.0",
    "pinia": "^4.0.2",
    "primevue": "^4.5.5",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "cross-env": "^10.1.0",
    "typescript": "~6.0.3",
    "vite": "^8.2.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vue-tsc": "^3.3.9"
  }
}
